# Configuración del transcriptor. Copiar a `.env` y llenar.
#
# Este archivo NO lleva valores reales: `.env` está ignorado por git.

# ── Convex ────────────────────────────────────────────────────
# OJO: es el dominio .convex.site (rutas HTTP), no el .convex.cloud.
CONVEX_SITE_URL=https://TU-DEPLOYMENT.convex.site
# El mismo valor que `bunx convex env get TRANSCRIPTOR_SECRET`.
TRANSCRIPTOR_SECRET=

# ── Servidor de medios ────────────────────────────────────────
# Las mismas llaves del livekit.yaml de al lado.
LIVEKIT_URL=wss://sala.vekino.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Motor de voz ──────────────────────────────────────────────
DEEPGRAM_API_KEY=
# Modelo. `nova-2` tiene el soporte de español más sólido en streaming.
DEEPGRAM_MODELO=nova-2
TRANSCRIPTOR_IDIOMA=es

# ── Ajustes finos (opcionales) ────────────────────────────────
# Cada cuánto se pregunta a qué salas entrar.
TRANSCRIPTOR_SONDEO_MS=10000
# Silencio tras el cual se suelta el socket del motor y se deja de pagar.
TRANSCRIPTOR_SILENCIO_MS=15000
# Corte de un párrafo largo en el acta.
TRANSCRIPTOR_MAX_CARACTERES=600
TRANSCRIPTOR_MAX_DURACION_MS=45000
